# Copy to .env.local and fill in values.
#
# Vercel Pro (or higher): /api/generate uses maxDuration=90s — Hobby tier times out at 10s.
# After first deploy, set NEXT_PUBLIC_BASE_URL to your canonical URL (custom domain).
# Stripe: add webhook URL https://YOUR_DOMAIN/api/webhooks/stripe → checkout.session.completed

# --- Anthropic (server-only) ---
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_SIGNATURE=
STRIPE_PRICE_ID_TRIPLE=
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
# Optional — use a verified domain in production, e.g. Plate Studio <hello@yourdomain.com>
# RESEND_FROM_EMAIL=

# --- App URL (production / custom domain) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
